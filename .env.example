ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_SELLER_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_CHANNEL_ID=
SHAFA_ROOT_DIR=
# Сайт Viktoria Shoes: ключ API інтеграції (секрет; необов'язковий) і перемикач (1 — відправляти)
SITE_INTEGRATION_KEY=
SHAFA_SITE_SEND=
# Кнопка «Запитати про цю пару» під постами бота (порожньо — увімкнено, «ні» — вимкнути)
SHAFA_ASK_BUTTON=
# Кнопка «Більше взуття на сайті» під постами бота (порожньо — увімкнено, «ні» — вимкнути)
SHAFA_SITE_BUTTON=
# Щоденний звіт Власнику в Telegram о цій годині (ГГ:ХХ); порожньо чи off — вимкнено; не задано — 21:00
SHAFA_REPORT_AT=21:00
# Тривоги Власнику в Telegram одразу (зупинка робота, нові Проблеми, збій самоперевірки, бюджет ШІ); off — вимкнено; порожньо — увімкнено
SHAFA_ALERTS=
# Бот на сервері (OPS-004): хост для ssh (напр. ubuntu@1.2.3.4); порожньо — бот на цьому компі.
# Ключ обміну — шлях до файлу (порожньо — bot-server-key у теці даних); сам ключ — ніколи не в git
SHAFA_BOT_SERVER=
SHAFA_BOT_SERVER_KEY=
